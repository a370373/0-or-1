# ==================================================
# Project: 01
# 專案：01 原生機器碼載入器
#
# Program: Hello World
# 程式：中英文問候語
#
# Architecture: ARM64 / AArch64
# 架構：ARM64 / AArch64
#
# ABI: Linux / Android AArch64 syscall
# 系統介面：Linux / Android ARM64 系統呼叫
#
# Purpose: Print English and Traditional Chinese
# 目的：輸出英文與繁體中文
#
# Output: Hello, World! 你好，世界！
# 輸出：Hello, World! 你好，世界！
# ==================================================


# --------------------------------------------------
# Part 1: Prepare the output
# 第一部分：準備輸出
#
# mov x0, #1
# Set file descriptor to stdout (1).
# 將檔案描述符設為標準輸出（1）。
# --------------------------------------------------

00100000 00000000 10000000 11010010


# --------------------------------------------------
# Part 2: Locate the message
# 第二部分：定位訊息
#
# adr x1, message
# Calculate the address of the message.
# 計算訊息在記憶體中的位址。
#
# The message starts 24 bytes after this instruction.
# 訊息位於這條指令之後 24 個位元組的位置。
# --------------------------------------------------

11000001 00000000 00000000 00010000


# --------------------------------------------------
# Part 3: Set message length
# 第三部分：設定訊息長度
#
# mov x2, #33
# The UTF-8 message contains 33 bytes.
# UTF-8 訊息總長度為 33 個位元組。
# --------------------------------------------------

00100010 00000100 10000000 11010010


# --------------------------------------------------
# Part 4: Select the system call
# 第四部分：選擇系統呼叫
#
# mov x8, #64
# AArch64 Linux syscall 64 = write.
# ARM64 Linux 的系統呼叫編號 64 代表 write。
# --------------------------------------------------

00001000 00001000 10000000 11010010


# --------------------------------------------------
# Part 5: Print the message
# 第五部分：輸出訊息
#
# svc #0
# Request the operating system to execute write().
# 要求作業系統執行 write() 系統呼叫。
# --------------------------------------------------

00000001 00000000 00000000 11010100


# --------------------------------------------------
# Part 6: Return successfully
# 第六部分：正常返回
#
# mov w0, #0
# Set the function return value to zero.
# 將函式返回值設為零。
# --------------------------------------------------

00000000 00000000 10000000 01010010


# ret
# Return to the 01 loader.
# 返回 01 載入器。

11000000 00000011 01011111 11010110


# ==================================================
# Part 7: Message data
# 第七部分：訊息資料
#
# These bytes are UTF-8 text, not instructions.
# 以下位元組是 UTF-8 文字，不是機器指令。
#
# message: "Hello, World! 你好，世界！\n"
# 訊息：英文問候語、繁體中文及換行。
#
# UTF-8 data begins immediately after the RET instruction.
# UTF-8 資料緊接在 RET 指令之後。
# ==================================================

# English: "Hello, "
# 英文：Hello,
01001000 01100101 01101100 01101100
01101111 00101100 00100000

# English: "World! "
# 英文：World!
01010111 01101111 01110010 01101100
01100100 00100001 00100000

# Chinese: "你"
# 中文：你
11100100 10111101 10100000

# Chinese: "好"
# 中文：好
11100101 10100101 10111101

# Chinese punctuation: "，"
# 中文標點：，
11101111 10111100 10001100

# Chinese: "世"
# 中文：世
11100100 10111000 10010110

# Chinese: "界"
# 中文：界
11100111 10010101 10001100

# Chinese punctuation: "！"
# 中文標點：！
11101111 10111100 10000001

# Newline: "\n"
# 換行字元
00001010
